<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:FluentAvalonia.UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:SvwsIccImporter.ViewModel"
             x:DataType="{x:Type vm:ImportViewModel}"
             xmlns:local="using:SvwsIccImporter.View"
             x:Class="SvwsIccImporter.View.ImportPage">

             <ScrollViewer>
                 <Grid Margin="10">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:FACommandBar Grid.ColumnSpan="2">
                        <controls:FACommandBar.PrimaryCommands>
                            <controls:FACommandBarElementContainer>
                                <controls:FAComboBox ItemsSource="{Binding Sections}"
                                                     SelectedItem="{Binding SelectedSection}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0">
                                             <controls:FAComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                            <Run Text="{Binding Schuljahr}" />
                                                            <Run Text=" / " />
                                                            <Run Text="{Binding Abschnitt}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </controls:FAComboBox.ItemTemplate>
                                </controls:FAComboBox>
                            </controls:FACommandBarElementContainer>

                            <controls:FACommandBarSeparator />

                            <controls:FACommandBarButton IconSource="Upload" Command="{Binding ImportCommand}" Label="Import starten" />
                            <controls:FACommandBarButton IconSource="Cancel" Command="{Binding CancelCommand}" Label="Import abbrechen" />

                            <controls:FACommandBarSeparator />

                            <controls:FACommandBarElementContainer>
                                <controls:FAProgressRing IsVisible="{Binding IsBusy}" />
                            </controls:FACommandBarElementContainer>

                            <controls:FACommandBarElementContainer>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="{Binding BusyText}"/>
                            </controls:FACommandBarElementContainer>
                        </controls:FACommandBar.PrimaryCommands>
                    </controls:FACommandBar>

                    <local:ImportTask Grid.Row="1" Grid.Column="0"
                                     CheckboxLabel="Lehrkräfte"
                                     IsChecked="{Binding TeachersViewModel.IsChecked, Mode=TwoWay}"
                                     BusyText="{Binding TeachersViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="TeachersViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="1" Grid.Column="1"
                                      CheckboxLabel="Fächer"
                                      IsChecked="{Binding SubjectsViewModel.IsChecked, Mode=TwoWay}"
                                      BusyText="{Binding SubjectsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="SubjectsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="2" Grid.Column="0"
                                      CheckboxLabel="Klassen"
                                      IsChecked="{Binding GradesViewModel.IsChecked, Mode=TwoWay}"
                                      BusyText="{Binding GradesViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="GradesViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="2" Grid.Column="1"
                                    CheckboxLabel="Lernende"
                                    IsChecked="{Binding StudentsViewModel.IsChecked, Mode=TwoWay}"
                                    BusyText="{Binding StudentsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="StudentsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="3" Grid.Column="0"
                                            CheckboxLabel="Klassenleitungen"
                                            IsChecked="{Binding GradeTeachersViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding GradeTeachersViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="GradeTeachersViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="3" Grid.Column="1"
                                            CheckboxLabel="Klassenmitgliedschaften"
                                            IsChecked="{Binding GradeMembershipsViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding GradeMembershipsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="GradeMembershipsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="4" Grid.Column="0"
                                            CheckboxLabel="Lernplattformen"
                                            IsChecked="{Binding LmsViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding LmsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="LmsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="4" Grid.Column="1"
                                            CheckboxLabel="Schüler-Lernplattforminfos"
                                            IsChecked="{Binding StudentsLmsViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding StudentsLmsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="StudentsLmsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="5" Grid.Column="0"
                                            CheckboxLabel="Datenschutzkategorien"
                                            IsChecked="{Binding PrivacyCategoriesViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding PrivacyCategoriesViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="PrivacyCategoriesViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="5" Grid.Column="1"
                                            CheckboxLabel="Unterrichte"
                                            IsChecked="{Binding TuitionsViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding TuitionsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="TuitionsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="6" Grid.Column="0"
                                            CheckboxLabel="Lerngruppen"
                                            IsChecked="{Binding StudyGroupsViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding StudyGroupsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="StudyGroupsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                    <local:ImportTask Grid.Row="6" Grid.Column="1"
                                            CheckboxLabel="Lerngruppen-Mitgliedschaften"
                                            IsChecked="{Binding StudyGroupMembershipsViewModel.IsChecked, Mode=TwoWay}"
                                            BusyText="{Binding StudyGroupMembershipsViewModel.BusyText}">
                        <local:ImportTask.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"></Binding>
                                <Binding Path="StudyGroupMembershipsViewModel.IsDisabled" Converter="{x:Static BoolConverters.Not}"></Binding>
                            </MultiBinding>
                        </local:ImportTask.IsEnabled>    
                    </local:ImportTask>

                 </Grid>
             </ScrollViewer>
</ContentPage>