<Page x:Class="SvwsIccImporter.View.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SvwsIccImporter.View"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ImportPage">


    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox
                        ItemsSource="{Binding ViewModel.Sections}"
                        SelectedItem="{Binding ViewModel.SelectedSection, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                            <Run Text="{Binding Schuljahr}" />
                            <Run Text=" / " />
                            <Run Text="{Binding Abschnitt}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Grid.Row="0" Grid.Column="1">
            <ui:TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="{Binding ViewModel.BusyText}"/>
            <ui:Button Content="Import starten" Icon="Upload" Margin="0,0,5,0" Command="{Binding ViewModel.ImportCommand}" />
            <ui:Button Content="Import abbrechen" Icon="Cancel" Command="{Binding ViewModel.CancelCommand}" />
        </StackPanel>

        <local:ImportTask Grid.Row="1" Grid.Column="0"
                                CheckboxLabel="Lehrkräfte"
                                DataContext="{Binding ViewModel.TeachersViewModel}" Height="48" Margin="0,0,0,48" Grid.RowSpan="2" VerticalAlignment="Bottom" />

        <local:ImportTask Grid.Row="1" Grid.Column="1"
                                CheckboxLabel="Fächer"
                                DataContext="{Binding ViewModel.SubjectsViewModel}" />

        <local:ImportTask Grid.Row="2" Grid.Column="0"
                                CheckboxLabel="Klassen"
                                DataContext="{Binding ViewModel.GradesViewModel}" />

        <local:ImportTask Grid.Row="2" Grid.Column="1"
                                CheckboxLabel="Lernende"
                                DataContext="{Binding ViewModel.StudentsViewModel}" />

        <local:ImportTask Grid.Row="3" Grid.Column="0"
                                CheckboxLabel="Klassenleitungen"
                                DataContext="{Binding ViewModel.GradeTeachersViewModel}" />

        <local:ImportTask Grid.Row="3" Grid.Column="1"
                                CheckboxLabel="Klassenmitgliedschaften"
                                DataContext="{Binding ViewModel.GradeMembershipsViewModel}" />

        <local:ImportTask Grid.Row="4" Grid.Column="0"
                                CheckboxLabel="Lernplattformen"
                                DataContext="{Binding ViewModel.LmsViewModel}" />

        <local:ImportTask Grid.Row="4" Grid.Column="1"
                                CheckboxLabel="Schüler-Lernplattforminfos"
                                DataContext="{Binding ViewModel.StudentsLmsViewModel}" />

        <local:ImportTask Grid.Row="5" Grid.Column="0"
                                CheckboxLabel="Datenschutzkategorien"
                                DataContext="{Binding ViewModel.PrivacyCategoriesViewModel}" />

        <local:ImportTask Grid.Row="5" Grid.Column="1"
                                CheckboxLabel="Unterrichte"
                                DataContext="{Binding ViewModel.TuitionsViewModel}" />

        <local:ImportTask Grid.Row="6" Grid.Column="0"
                                CheckboxLabel="Lerngruppen"
                                DataContext="{Binding ViewModel.StudyGroupsViewModel}" />

        <local:ImportTask Grid.Row="6" Grid.Column="1"
                                CheckboxLabel="Lerngruppen-Mitgliedschaften"
                                DataContext="{Binding ViewModel.StudyGroupMembershipsViewModel}" />

    </Grid>
</Page>
